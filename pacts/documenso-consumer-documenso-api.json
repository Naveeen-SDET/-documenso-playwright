{
  "consumer": {
    "name": "documenso-consumer"
  },
  "interactions": [
    {
      "description": "a request for a document that does not exist",
      "providerStates": [
        {
          "name": "document with id 999999 does not exist"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-api-key"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/documents/999999"
      },
      "response": {
        "body": {
          "message": "Document not found"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 404
      }
    },
    {
      "description": "a request to fetch document by ID",
      "providerStates": [
        {
          "name": "document with id 1 exists"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-api-key"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/documents/1"
      },
      "response": {
        "body": {
          "createdAt": "2025-01-01T00:00:00.000Z",
          "id": 1,
          "status": "DRAFT",
          "title": "Test Document",
          "updatedAt": "2025-01-01T00:00:00.000Z"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                  "match": "datetime"
                }
              ]
            },
            "$.id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.updatedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                  "match": "datetime"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to list documents",
      "providerStates": [
        {
          "name": "documents exist for the authenticated user"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-api-key"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/documents",
        "query": {
          "page": [
            "1"
          ],
          "perPage": [
            "10"
          ]
        }
      },
      "response": {
        "body": {
          "documents": [
            {
              "createdAt": "2025-01-01T00:00:00.000Z",
              "id": 1,
              "status": "DRAFT",
              "title": "Test Document",
              "updatedAt": "2025-01-01T00:00:00.000Z"
            }
          ],
          "totalPages": 1
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.documents": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.documents[*].createdAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                  "match": "datetime"
                }
              ]
            },
            "$.documents[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.documents[*].status": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.documents[*].title": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.documents[*].updatedAt": {
              "combine": "AND",
              "matchers": [
                {
                  "format": "yyyy-MM-dd'T'HH:mm:ss.SSS'Z'",
                  "match": "datetime"
                }
              ]
            },
            "$.totalPages": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a request to list documents when account is empty",
      "providerStates": [
        {
          "name": "no documents exist for the authenticated user"
        }
      ],
      "request": {
        "headers": {
          "Authorization": "Bearer test-api-key"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/api/v1/documents",
        "query": {
          "page": [
            "1"
          ],
          "perPage": [
            "10"
          ]
        }
      },
      "response": {
        "body": {
          "documents": [],
          "totalPages": 0
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.totalPages": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "an unauthenticated request to list documents",
      "providerStates": [
        {
          "name": "no authentication provided"
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/v1/documents"
      },
      "response": {
        "body": {
          "message": "Unauthorized"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.message": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "status": 401
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "16.4.0"
    },
    "pactRust": {
      "ffi": "0.5.4",
      "models": "1.3.11"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "documenso-api"
  }
}