# ── Environment configuration ─────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# All variables are validated with Zod at test startup — missing or malformed
# values will produce a clear error message before any test runs.
#
# Required to run tests locally:
#   1. Start Documenso with Docker: docker compose -f documenso-app/docker/testing/compose.yml up -d
#   2. Create an API key in the Documenso UI → Settings → API tokens
#   3. Fill in SENDER_PASSWORD, SIGNER_PASSWORD, and DOCUMENSO_API_KEY below

# ── App endpoints ─────────────────────────────────────────────────────────────
# URL of the running Documenso instance
# Must include the scheme: http://localhost:3000 ✓   localhost:3000 ✗
BASE_URL=http://localhost:3000

# URL of the Inbucket email testing server (used for email flow tests)
INBUCKET_URL=http://localhost:9000

# ── Test account credentials ──────────────────────────────────────────────────
# These accounts are pre-seeded by the Documenso Docker test environment
SENDER_EMAIL=sender@test.com
SENDER_PASSWORD=

SIGNER_EMAIL=signer@test.com
SIGNER_PASSWORD=

# ── API key ───────────────────────────────────────────────────────────────────
# Optional — tests that require an API key skip gracefully when this is absent.
# Create one at: Documenso UI → Settings → API tokens
DOCUMENSO_API_KEY=

# ── Active environment ────────────────────────────────────────────────────────
# Controls which environment is active. Used for multi-env test selection.
# Allowed values: local | ci | staging | production
# Default: local
TEST_ENV=local
