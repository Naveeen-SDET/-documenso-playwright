[
  {
    "name": "Security failures",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*(X-Content-Type|X-Frame|Referrer-Policy|clickjack|HttpOnly|SameSite|MIME|XSS|injection|stack trace).*"
  },
  {
    "name": "Accessibility violations",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*axe.*|.*violation.*|.*WCAG.*|.*a11y.*"
  },
  {
    "name": "API contract failures",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*(schema|contract|Zod|parse|unexpected field|missing field).*"
  },
  {
    "name": "Authentication failures",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*(401|403|Unauthorized|Forbidden|token|auth|signin|signout).*"
  },
  {
    "name": "Performance budget exceeded",
    "matchedStatuses": ["failed"],
    "messageRegex": ".*(budget|ms —|milliseconds|TTFB|load time|p95|p99).*"
  },
  {
    "name": "App not reachable (Docker down)",
    "matchedStatuses": ["skipped"],
    "messageRegex": ".*(ECONNREFUSED|Docker|not reachable|start Docker).*"
  },
  {
    "name": "Missing API key",
    "matchedStatuses": ["skipped"],
    "messageRegex": ".*(API key|DOCUMENSO_API_KEY|api key).*"
  },
  {
    "name": "Infrastructure / timeout",
    "matchedStatuses": ["failed", "broken"],
    "messageRegex": ".*(timeout|ECONNRESET|ETIMEDOUT|net::ERR).*"
  },
  {
    "name": "Test bugs",
    "matchedStatuses": ["broken"],
    "messageRegex": ".*"
  }
]
